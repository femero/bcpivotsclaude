{
  "permissions": {
    "allow": [
      "Bash(mvn spotless:apply)",
      "Bash(mvn clean verify)",
      "Bash(mvn test)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-code.sh"
          }
        ]
      }
    ]
  }
}
